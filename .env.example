# Copy to .env and replace every example value before starting the stack.
POSTGRES_DB=anb_hosting
POSTGRES_USER=anb_dev
POSTGRES_PASSWORD=replace-with-a-unique-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
ENGINE_TOKEN=replace-with-a-second-random-secret-of-at-least-32-characters
ENGINE_URL=http://localhost:3010
WEBSITE_DOMAIN_SUFFIX=sites.example.test
LAN_ALLOWED_CIDR=192.168.1.0/24
LAN_SERVER_IP=192.168.1.50
COOKIE_SECURE=true
WEB_ORIGINS=http://localhost:3000,http://localhost:8080
NEXT_PUBLIC_API_URL=/api/v1
DATABASE_URL=postgresql://anb_dev:replace-with-a-unique-local-password@localhost:5432/anb_hosting?schema=public
