{
  "root": true,
  "env": {
    "es2022": true,
    "node": true,
    "browser": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "dist/"
  ],
  "overrides": [
    {
      "files": [
        "**/*.spec.ts"
      ],
      "env": {
        "jest": true
      }
    },
    {
      "files": [
        "apps/dashboard/**/*.{ts,tsx}"
      ],
      "extends": [
        "next/core-web-vitals"
      ]
    }
  ]
}
